# ---- Banco (bate com o docker-compose.yml da raiz) -------------------
DATABASE_URL=postgresql://otica:otica_dev_pwd@localhost:5432/otica_popular

# ---- API -------------------------------------------------------------
PORT=3333
NODE_ENV=development

# URL pública da API — usada para montar o link das imagens
API_PUBLIC_URL=http://localhost:3333

# Origens autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Segurança -------------------------------------------------------
# TROQUE ISSO. Gere um segredo forte com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-64-caracteres-no-minimo
JWT_EXPIRES_IN=8h

# ---- Upload de imagens ----------------------------------------------
# Diretório local onde as imagens ficam salvas (trocar por S3/Cloudinary depois)
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5

# ---- E-mail (lembrete de consulta pelo Gmail) ------------------------
# Use uma SENHA DE APP, não a senha normal da conta:
#   1. Ative a verificação em duas etapas em myaccount.google.com/security
#   2. Gere a senha em myaccount.google.com/apppasswords
#   3. Cole aqui as 16 letras (pode colar com os espaços)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Nome que aparece como remetente. Vazio = "Óptica Popular <SMTP_USER>"
SMTP_FROM=

# ---- Lembretes de consulta -------------------------------------------
# Fuso usado pelo agendador e pelas datas das consultas
TIMEZONE=America/Sao_Paulo
# true/false — desliga o disparo automático sem mexer no código
LEMBRETES_ATIVO=true
# Quando varrer a agenda. Padrão: todo dia às 08:00, avisando quem tem
# consulta no dia seguinte. Formato cron: minuto hora dia mês dia-da-semana
LEMBRETES_CRON=0 8 * * *

# ---- Dados que aparecem no e-mail ------------------------------------
OTICA_NOME=Óptica Popular
OTICA_TELEFONE=
OTICA_ENDERECO=
