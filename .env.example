# =====================================================================
# Variáveis do docker-compose.yml (banco + pgAdmin)
# Copie para .env e ajuste se quiser.  cp .env.example .env
# =====================================================================
POSTGRES_USER=otica
POSTGRES_PASSWORD=otica_dev_pwd
POSTGRES_DB=otica_popular
POSTGRES_PORT=5432
# IP do host onde a porta é publicada. 127.0.0.1 = só o próprio servidor
# enxerga o banco (é o que se quer em produção). 0.0.0.0 abre para a rede.
POSTGRES_BIND_IP=127.0.0.1

PGADMIN_EMAIL=admin@oticapopular.com.br
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050
PGADMIN_BIND_IP=127.0.0.1
