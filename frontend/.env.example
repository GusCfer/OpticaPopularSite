# URL da API (backend). Precisa bater com CORS_ORIGINS no backend/.env
VITE_API_URL=http://localhost:3333

# Em produção, com o Nginx servindo site e API no mesmo domínio, deixe VAZIO:
#   VITE_API_URL=
# As chamadas viram /api/... na própria origem — sem CORS e sem o domínio
# ficar gravado dentro do JavaScript compilado.
